# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                     CONFLUENT CLOUD TABLEFLOW DEMO                         ║
# ║                                                                            ║
# ║  Copy this file to terraform.tfvars and fill in the values below.          ║
# ║  Only uncomment the sections relevant to your cloud provider and           ║
# ║  catalog types.                                                            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ REQUIRED FOR ALL DEPLOYMENTS                                               │
# └────────────────────────────────────────────────────────────────────────────┘

confluent_cloud_api_key    = "YOUR_CONFLUENT_CLOUD_API_KEY"
confluent_cloud_api_secret = "YOUR_CONFLUENT_CLOUD_API_SECRET"
environment_display_name   = "Tableflow Demo"

# Cloud provider: "aws" or "azure"
cloud_provider = "aws"

# Region (AWS format: "us-east-1" | Azure format: "eastus")
region = "us-east-1"

# Catalog integrations to enable. Pick from the table below:
#
#   ┌──────────────┬───────────────────────────────────────────────────────────┐
#   │ Catalog Type │ Supported Cloud Providers                               │
#   ├──────────────┼───────────────────────────────────────────────────────────┤
#   │ "databricks" │ AWS, Azure                                              │
#   │ "snowflake"  │ AWS, Azure                                              │
#   │ "glue"       │ AWS only                                                │
#   └──────────────┴───────────────────────────────────────────────────────────┘
#
# Examples:
#   AWS:   catalog_types = ["databricks", "snowflake", "glue"]
#   Azure: catalog_types = ["databricks", "snowflake"]

catalog_types = ["databricks"]


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ AWS-SPECIFIC (Required when cloud_provider = "aws")                        │
# │                                                                            │
# │ No additional variables needed. AWS credentials are read from your         │
# │ AWS CLI configuration (run: aws configure).                                │
# └────────────────────────────────────────────────────────────────────────────┘


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ AZURE-SPECIFIC (Required when cloud_provider = "azure")                    │
# │                                                                            │
# │ Uncomment and fill in these values if using Azure.                         │
# │ Azure CLI must be configured (run: az login).                              │
# └────────────────────────────────────────────────────────────────────────────┘

# azure_subscription_id             = "your-azure-subscription-id"
# azure_tenant_id                   = "your-azure-tenant-id"
# azure_resource_group_name         = "tableflow-rg"          # Must exist already
# azure_storage_account_name_prefix = "cflttflow"             # 3-15 lowercase alphanumeric


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ DATABRICKS (Required when "databricks" is in catalog_types)                │
# │                                                                            │
# │ ► AZURE: No Databricks variables needed! The project auto-provisions:      │
# │   - Databricks workspace                                                  │
# │   - Unity Catalog metastore                                               │
# │   - Access connector with managed identity                                │
# │   - Service principal with OAuth M2M secret                               │
# │   - SQL warehouse                                                         │
# │   - Storage credential, external location, catalog, and grants            │
# │                                                                            │
# │   After terraform apply, retrieve Tableflow integration credentials:       │
# │     terraform output azure_databricks_workspace_url  # Host               │
# │     terraform output databricks_sp_client_id         # Client ID          │
# │     terraform output databricks_oauth_secret         # Client Secret      │
# │     terraform output databricks_catalog_name         # Catalog            │
# │                                                                            │
# │ ► AWS: Requires an existing Databricks workspace. Uncomment and fill:      │
# └────────────────────────────────────────────────────────────────────────────┘

# --- AWS Databricks (existing workspace) ---
# databricks_host               = "https://your-workspace.cloud.databricks.com"
# databricks_token              = "your-personal-access-token"
# databricks_workspace_id       = "1234567890"
# databricks_workspace_name     = "your-workspace-name"
# databricks_account_id         = "your-account-uuid"
# databricks_sql_warehouse_name = "your-sql-warehouse"
# databricks_client_id          = "your-oauth-client-id"

# --- Azure Databricks (advanced - only if using a pre-existing workspace) ---
# databricks_workspace_url      = "https://adb-xxxxx.xx.azuredatabricks.net"
# databricks_workspace_id       = "1234567890"
# databricks_metastore_id       = "existing-metastore-uuid"   # Skip metastore creation


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ SNOWFLAKE (Required when "snowflake" is in catalog_types)                  │
# │                                                                            │
# │ Works with both AWS and Azure deployments.                                 │
# │ Uncomment and fill in if using Snowflake catalog integration.              │
# └────────────────────────────────────────────────────────────────────────────┘

# snowflake_endpoint      = "https://YOUR_ACCOUNT.YOUR_REGION.snowflakecomputing.com"
# snowflake_warehouse     = "YOUR_WAREHOUSE_NAME"
# snowflake_allowed_scope = "PRINCIPAL_ROLE:YOUR_ROLE"

# --- Polaris / Snowflake Open Data (used by Snowflake catalog integration) ---
# polaris_client_id     = "your-polaris-client-id"
# polaris_client_secret = "your-polaris-client-secret"
# polaris_account_name  = "your-polaris-account-name"
# polaris_username      = "your-polaris-username"
# polaris_password      = "your-polaris-password"
# polaris_region        = "us-east-1"


# ┌────────────────────────────────────────────────────────────────────────────┐
# │ GLUE (Required when "glue" is in catalog_types)                            │
# │                                                                            │
# │ AWS only. No additional variables needed beyond AWS credentials.           │
# │ The Glue catalog database and IAM permissions are auto-provisioned.        │
# └────────────────────────────────────────────────────────────────────────────┘


